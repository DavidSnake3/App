<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6366f1</item>
        <item name="colorPrimaryDark">#1e1b4b</item>
        <item name="colorAccent">#6366f1</item>
        <item name="android:windowBackground">#0f0e1a</item>
        <item name="android:statusBarColor">#0f0e1a</item>
        <item name="android:navigationBarColor">#1a1830</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0f0e1a</item>
        <item name="android:statusBarColor">#0f0e1a</item>
        <item name="android:navigationBarColor">#1a1830</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#0f0e1a</item>
        <item name="android:statusBarColor">#0f0e1a</item>
        <item name="android:navigationBarColor">#0f0e1a</item>
    </style>

</resources>
